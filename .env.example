APP__ENV=development
APP__HTTP__PORT=8080
# Confiar en X-Forwarded-For solo desde redes privadas o locales (el BFF). Ver docs/04.
APP__HTTP__TRUST_PRIVATE_PROXIES=true
APP__DATABASE__URL=postgres://qatu:qatu@localhost:5433/qatu?sslmode=disable
APP__REDIS__ADDR=localhost:6379
APP__SESSION__COOKIE_NAME=qatu_session
APP__SESSION__TTL=720h
APP__SESSION__RENEW_AFTER=24h
# Versión de los textos legales vigentes (se guarda en cada consentimiento).
APP__LEGAL__TERMS_VERSION=borrador-2026-09
APP__LEGAL__PRIVACY_VERSION=borrador-2026-09
# Correo (SMTP genérico). Local: Mailpit en localhost:1025 sin usuario. Producción: cualquier proveedor SMTP.
APP__SMTP__HOST=localhost
APP__SMTP__PORT=1025
APP__SMTP__USERNAME=
APP__SMTP__PASSWORD=
APP__SMTP__FROM=Qatu <no-responder@qatu.local>
# Clave para firmar (HMAC) los códigos de 6 dígitos. Obligatoria y aleatoria en producción:
#   openssl rand -hex 32
APP__SECURITY__CODE_SECRET=
# Desplaza el punto público de cada publicación (feature 003). Obligatorio en producción.
APP__SECURITY__LOCATION_SECRET=
# Códigos de verificación y recuperación (valores iniciales de la feature 001).
APP__CODES__TTL=15m
APP__CODES__MAX_ATTEMPTS=5
APP__CODES__RESEND_COOLDOWN=1m
# Acceso con Google (Google Cloud → Google Auth Platform → Clientes, tipo "Aplicación web").
# Obligatorio en producción; vacío en desarrollo lo desactiva. El redirect va al BFF de qatu-app.
APP__GOOGLE__CLIENT_ID=
APP__GOOGLE__CLIENT_SECRET=
APP__GOOGLE__REDIRECT_URL=http://localhost:3000/api/auth/google/callback
# Captcha en registro y recuperación. Obligatorio en producción; vacío en desarrollo lo desactiva.
# Claves de prueba de Cloudflare: 1x0000000000000000000000000000000AA (siempre pasa),
# 2x0000000000000000000000000000000AA (siempre falla).
APP__TURNSTILE__SECRET=
APP__IPQUERY__BASE_URL=
# Límite de intentos (valores de partida a validar en el piloto).
APP__RATELIMIT__AUTH_PER_IP__MAX=30
APP__RATELIMIT__AUTH_PER_IP__WINDOW=15m
APP__RATELIMIT__LOGIN_PER_ACCOUNT__MAX=5
APP__RATELIMIT__LOGIN_PER_ACCOUNT__WINDOW=15m
