meta {
  name: Rechazar
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/moderation/listings/{{listingId}}/reject
  body: json
  auth: inherit
}

body:json {
  {
    "version": {{listingVersion}},
    "reason": "La foto de portada no muestra la herramienta."
  }
}

docs {
  El arrendador lee el motivo, corrige y la vuelve a enviar.
}
