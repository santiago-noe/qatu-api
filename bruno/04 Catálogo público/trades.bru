meta {
  name: Oficios
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/catalog/categories?vertical=service&city=ayacucho
  body: none
  auth: none
}

params:query {
  vertical: service
  city: ayacucho
}

script:post-response {
  if (res.status === 200 && res.body.categories?.length) bru.setEnvVar("tradeId", res.body.categories[0].id);
}
