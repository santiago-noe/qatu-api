meta {
  name: Registrarse
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "name": "Ana Quispe",
    "password": "{{password}}",
    "adult_declared": true,
    "accept_legal": true
  }
}

script:post-response {
  if (res.status < 300 && res.body?.session?.token) bru.setEnvVar("token", res.body.session.token);
}

docs {
  Con Turnstile configurado, agrega la cabecera X-Turnstile-Token. El código llega a Mailpit (localhost:8025).
}
