meta {
  name: Ver publicación
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/me/listings/{{listingId}}
  body: none
  auth: inherit
}

script:post-response {
  if (res.status < 300 && res.body?.id) { bru.setEnvVar("listingId", res.body.id); bru.setEnvVar("listingVersion", res.body.version); }
}
